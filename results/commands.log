2026-10-06T12:45:38Z host=144.126.201.137 cmd=sudo -u postgres psql -d social -v ON_ERROR_STOP=1 -At <<'SQL'
SELECT blks_hit || ',' || blks_read FROM pg_stat_database WHERE datname = 'social';
SQL
2026-10-06T12:45:39Z host=144.126.201.137 cmd=sudo -u postgres psql -d social -v ON_ERROR_STOP=1 -At <<'SQL'

COPY (
  SELECT queryid::text, calls, total_exec_time, rows,
         regexp_replace(query, E'[\n\r]+', ' ', 'g')
  FROM pg_stat_statements
  WHERE dbid = (SELECT oid FROM pg_database WHERE datname = 'social')
) TO STDOUT WITH (FORMAT csv);

SQL
2026-10-06T12:45:40Z host=144.126.201.137 cmd=sudo -u postgres psql -d social -v ON_ERROR_STOP=1 -At <<'SQL'

COPY (
  SELECT relname, n_tup_ins, n_tup_upd, n_tup_del
  FROM pg_stat_user_tables
  WHERE relname IN ('posts', 'likes')
) TO STDOUT WITH (FORMAT csv);

SQL
2026-10-06T12:45:41Z host=144.126.201.137 cmd=sudo -u postgres psql -d social -v ON_ERROR_STOP=1 -At <<'SQL'

SELECT 'max=' || max(like_count)
    || ' tied=' || count(*) FILTER (WHERE like_count = (SELECT max(like_count) FROM posts))
FROM posts;
SELECT id::text || ' like_count=' || like_count::text
    || ' likes_rows=' || (SELECT count(*) FROM likes l WHERE l.post_id = posts.id)::text
FROM posts
ORDER BY like_count DESC, id DESC
LIMIT 3;

SQL
