nohup bash -c 'while true; do sudo -u postgres psql -d social -v ON_ERROR_STOP=1 -At -F, -f /var/tmp/pg-limit/sample_waits.sql; sleep 5; done' > /var/tmp/pg-limit/100m-v2-write-search-05/waits.csv 2>/var/tmp/pg-limit/100m-v2-write-search-05/waits.err & echo $! > /var/tmp/pg-limit/100m-v2-write-search-05/waits.pid

