WITH top AS MATERIALIZED (
    SELECT id, like_count
    FROM posts
    ORDER BY like_count DESC, id DESC
    LIMIT 3
)
SELECT id::text || ' like_count=' || like_count::text
    || ' likes_rows=' || (SELECT count(*) FROM likes l WHERE l.post_id = top.id)::text
FROM top;

SQL
