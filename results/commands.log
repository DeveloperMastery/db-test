2026-10-06T22:09:36Z host=144.126.201.137 cmd=sudo -u postgres psql -d social -v ON_ERROR_STOP=1 -At <<'SQL'

SELECT 'size|' || r.relname || '|' || r.relkind || '|' || pg_relation_size(r.oid)
    || '|' || coalesce(t.relname, '')
FROM pg_class r
LEFT JOIN pg_index i ON i.indexrelid = r.oid
LEFT JOIN pg_class t ON t.oid = i.indrelid
JOIN pg_namespace n ON n.oid = r.relnamespace
WHERE n.nspname = 'public' AND r.relkind IN ('r', 'i')
ORDER BY 1;

SQL
