2026-10-07T13:29:48Z host=144.126.201.137 cmd=sudo -u postgres psql -d social -v ON_ERROR_STOP=1 -At <<'SQL'

COPY (
  SELECT queryid::text, calls, total_exec_time, rows,
         regexp_replace(query, E'[\n\r]+', ' ', 'g')
  FROM pg_stat_statements
  WHERE dbid = (SELECT oid FROM pg_database WHERE datname = 'social')
) TO STDOUT WITH (FORMAT csv);

SQL
2026-10-07T13:29:49Z host=144.126.201.137 cmd=sudo -u postgres psql -d social -v ON_ERROR_STOP=1 -At <<'SQL'

