rm -f /var/tmp/pg-limit/100m-split-warmup/*.pid
nohup vmstat 5 > /var/tmp/pg-limit/100m-split-warmup/vmstat.txt 2>&1 & echo $! > /var/tmp/pg-limit/100m-split-warmup/vmstat.pid
nohup iostat -x 5 > /var/tmp/pg-limit/100m-split-warmup/iostat.txt 2>&1 & echo $! > /var/tmp/pg-limit/100m-split-warmup/iostat.pid
