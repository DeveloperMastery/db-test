from pathlib import Path
path = Path("/root/.pgpass")
out = []
for line in path.read_text().splitlines():
    parts = line.split(":")
    if len(parts) >= 5 and parts[2] == "social":
        parts[0] = "10.130.0.4"
        out.append(":".join(parts))
    elif line:
        out.append(line)
path.write_text("\n".join(out) + "\n")
path.chmod(0o600)
PY
