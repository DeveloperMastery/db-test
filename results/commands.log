2026-10-06T16:38:41Z host=144.126.201.137 cmd=
set -e
mkdir -p /var/tmp/pg-limit/100m-replica-warmup
rm -f /var/tmp/pg-limit/100m-replica-warmup/*.pid
nohup vmstat 5 > /var/tmp/pg-limit/100m-replica-warmup/vmstat.txt 2>&1 & echo $! > /var/tmp/pg-limit/100m-replica-warmup/vmstat.pid
nohup iostat -x 5 > /var/tmp/pg-limit/100m-replica-warmup/iostat.txt 2>&1 & echo $! > /var/tmp/pg-limit/100m-replica-warmup/iostat.pid
nohup bash -c 'while true; do sudo -u postgres psql -d social -v ON_ERROR_STOP=1 -At -F, -f /var/tmp/pg-limit/sample_waits.sql; sleep 5; done' > /var/tmp/pg-limit/100m-replica-warmup/waits.csv 2>/var/tmp/pg-limit/100m-replica-warmup/waits.err & echo $! > /var/tmp/pg-limit/100m-replica-warmup/waits.pid

2026-10-06T16:38:42Z host=138.68.149.186 cmd=
set -e
mkdir -p /var/tmp/pg-limit/100m-replica-warmup
nohup mpstat -P ALL 5 > /var/tmp/pg-limit/100m-replica-warmup/mpstat.txt 2>&1 & echo $! > /var/tmp/pg-limit/100m-replica-warmup/mpstat.pid
nohup bash -c 'for i in $(seq 1 100); do pid=$(pgrep -n pgbench || true); [ -n "$pid" ] && break; sleep 0.2; done; if [ "1" = "1" ]; then exec pidstat -h -t -C pgbench 5; else exec pidstat -h -t -p "$pid" 5; fi' > /var/tmp/pg-limit/100m-replica-warmup/pidstat.txt 2>&1 & echo $! > /var/tmp/pg-limit/100m-replica-warmup/pidstat.pid

