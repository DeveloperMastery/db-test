rm -f /var/tmp/pg-limit/100m-split-confirm-r15651-1/*.pid
nohup vmstat 5 > /var/tmp/pg-limit/100m-split-confirm-r15651-1/vmstat.txt 2>&1 & echo $! > /var/tmp/pg-limit/100m-split-confirm-r15651-1/vmstat.pid
nohup iostat -x 5 > /var/tmp/pg-limit/100m-split-confirm-r15651-1/iostat.txt 2>&1 & echo $! > /var/tmp/pg-limit/100m-split-confirm-r15651-1/iostat.pid
nohup bash -c 'while true; do sudo -u postgres psql -d social -v ON_ERROR_STOP=1 -At -F, -f /var/tmp/pg-limit/sample_waits.sql; sleep 5; done' > /var/tmp/pg-limit/100m-split-confirm-r15651-1/waits.csv 2>/var/tmp/pg-limit/100m-split-confirm-r15651-1/waits.err & echo $! > /var/tmp/pg-limit/100m-split-confirm-r15651-1/waits.pid

